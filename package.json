{
  "name": "ingsoft2-project",
  "version": "1.0.0",
  "description": "Proyecto de Ingeniería de Software 2",
  "main": "dist/server/index.js",
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json",
    "docker:build": "docker compose build",
    "docker:run": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:file": "tsx scripts/run-integration-test.js",
    "test:integration:playlists": "vitest run --config vitest.integration.config.ts tests-integracion/playlists-*.ts",
    "test:integration:songs": "vitest run --config vitest.integration.config.ts tests-integracion/songs-*.ts",
    "test:mocked": "vitest run",
    "test:mocked:file": "tsx scripts/run-mocked-test.ts",
    "test:mocked:playlists": "vitest run tests-mocked/playlists-*.ts",
    "test:mocked:songs": "vitest run tests-mocked/songs-*.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml --env-file .env.test up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml --env-file .env.test down",
    "test:db:status": "tsx scripts/check-db-status.ts",
    "logs:clear": "node scripts/clear-logs.js",
    "logs:view": "tail -f logs/combined.log"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.2",
    "@hono/zod-openapi": "^0.9.6",
    "dotenv": "^16.4.5",
    "hono": "^4.0.5",
    "mysql2": "^3.9.7",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
